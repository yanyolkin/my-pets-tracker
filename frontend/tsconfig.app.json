{
    "compilerOptions": {
        "composite": true,
        "declaration": true,
        "emitDeclarationOnly": true,

        "target": "ES2022",
        "useDefineForClassFields": true,
        "lib": ["DOM", "DOM.Iterable", "ES2022"],
        "module": "ESNext",
        "skipLibCheck": true,

        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "react-jsx",

        /* Linting */
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true /* Исправлено имя для TS 6.0 */,

        "paths": {
            "@/*": ["./src/*"]
        },

        /* Типы для кода приложения и тестов */
        "types": [
            "vitest/globals",
            "@testing-library/jest-dom",
            "vite/client",
            "node"
        ]
    },
    "include": ["src/**/*"]
}
